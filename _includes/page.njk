---
layout: base.njk
---

<header class="relative isolate overflow-hidden border-b border-line">
  {% if contour %}
    <div class="contour-mask absolute inset-y-0 right-0 -z-10 w-full md:w-3/4" style="--contour-src: url('/contour/{{ contour }}.svg')" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-paper via-paper/85 to-paper/0" aria-hidden="true"></div>
  {% endif %}
  <div class="mx-auto max-w-site px-4 pb-12 pt-14 sm:px-6 md:pb-16 md:pt-20">
    {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    {% if title %}
      <h1 class="mt-3 font-display text-5xl font-extrabold leading-[0.95] tracking-[-0.025em] md:text-7xl">{{ title }}</h1>
    {% endif %}
    {% if description %}<p class="mt-5 max-w-2xl text-lg text-muted md:text-xl">{{ description | safe }}</p>{% endif %}
  </div>
</header>

<div class="mx-auto max-w-site px-4 sm:px-6">
  {{ content | safe }}
</div>
