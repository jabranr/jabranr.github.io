---
layout: base.njk
noindex: true
stylesheets:
  - /resume.css
---

<div class="resume mx-auto max-w-4xl px-4 pb-8 pt-12 sm:px-6 md:pt-16 print:max-w-none print:p-0">
  <header class="border-b border-line pb-6 print:border-b-0 print:pb-0">
    <p class="eyebrow print:hidden">Resume</p>
    <h1 class="wordmark-name mt-3 font-display text-5xl font-extrabold leading-none tracking-[-0.025em] md:text-6xl print:mt-0 print:text-[24pt]">{{ resume.title }}</h1>
  </header>
  {{ content | safe }}
</div>
