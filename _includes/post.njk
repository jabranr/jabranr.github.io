---
layout: base.njk
---

{% set older = collections.articles | getPreviousCollectionItem(page) %}
{% set newer = collections.articles | getNextCollectionItem(page) %}

<div class="reading-progress fixed inset-x-0 top-0 z-50 h-[3px] bg-accent print:hidden" aria-hidden="true"></div>

<article>
  <header class="relative isolate overflow-hidden border-b border-line">
    <div class="contour-mask absolute inset-0 -z-10" style="--contour-src: url('/contour/{{ page.fileSlug }}.svg')" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-paper via-paper/85 to-paper/10" aria-hidden="true"></div>
    <div class="mx-auto max-w-site px-4 pb-12 pt-10 sm:px-6 md:pb-16 md:pt-14">
      <nav aria-label="Breadcrumb" class="eyebrow">
        <a class="hover:text-ink" href="/">Home</a> <span aria-hidden="true">/</span> <a class="hover:text-ink" href="/articles/">Articles</a>
      </nav>
      <h1 class="mt-6 max-w-4xl font-display text-4xl font-extrabold leading-[1.02] tracking-[-0.02em] md:text-6xl" style="view-transition-name: {{ page.url | vtName }}">{{ title }}</h1>
      <p class="mt-6 font-mono text-sm text-muted">
        <time datetime="{{ date | format_date('YYYY-MM-DD') }}">{{ date | format_date }}</time>
        <span aria-hidden="true">&middot;</span> {{ content | timeToRead }} read
      </p>
    </div>
  </header>

  <div class="mx-auto max-w-site px-4 py-12 sm:px-6 md:py-16">
    <div class="prose article_content">
      {{ content | safe }}
    </div>
  </div>
</article>

{% if older or newer %}
  <nav aria-label="More articles" class="mx-auto max-w-site px-4 sm:px-6">
    <div class="grid gap-4 border-t border-line pt-10 md:grid-cols-2">
      {% if older %}
        <a rel="prev" href="{{ older.url | url }}" class="group rounded-xl border border-line bg-surface p-6 transition-colors hover:border-ink">
          <span class="eyebrow">&larr; Older</span>
          <span class="mt-2 block font-display text-xl font-bold leading-snug group-hover:text-accent">{{ older.data.title }}</span>
        </a>
      {% endif %}
      {% if newer %}
        <a rel="next" href="{{ newer.url | url }}" class="group rounded-xl border border-line bg-surface p-6 text-right transition-colors hover:border-ink md:col-start-2">
          <span class="eyebrow">Newer &rarr;</span>
          <span class="mt-2 block font-display text-xl font-bold leading-snug group-hover:text-accent">{{ newer.data.title }}</span>
        </a>
      {% endif %}
    </div>
  </nav>
{% endif %}
