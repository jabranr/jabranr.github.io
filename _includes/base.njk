{% if not title %}
  {% set title = site.title %}
{% else %}
  {% set title = title ~ " - " ~ site.name %}
{% endif %}

{% if not description %}
  {% set description = site.description %}
{% endif %}

{% set assetVersion = 'now' | format_date('unix') %}
{% set navItems = [
  { url: '/articles/', label: 'Articles' },
  { url: '/projects/', label: 'Projects' },
  { url: '/speaking/', label: 'Speaking' },
  { url: '/resume/', label: 'Resume' }
] %}
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}" />
    <meta name="author" content="{{ site.name }}" />
    <meta name="generator" content="{{ eleventy.generator }}" />
    <meta property="og:type" content="{% if layout == 'post' %}article{% else %}website{% endif %}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:image" content="{{ page.url | ogImage | absoluteUrl }}" />
    <meta property="og:image:alt" content="{{ title }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jabranr" />
    <meta name="twitter:creator" content="@jabranr" />
    <meta name="twitter:title" content="{{ title }}" />
    <meta name="twitter:description" content="{{ description }}" />
    <meta name="twitter:image" content="{{ page.url | ogImage | absoluteUrl }}" />
    <meta name="theme-color" content="#f4f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1510" media="(prefers-color-scheme: dark)" />
    {# Gets replaced in post build script #}
    <meta name="app:version" content="{{ 'VERSION' | appVersion }}" />
    {% if page.url == '/404/' or noindex %}
      <meta name="robots" content="noindex, nofollow" />
    {% else %}
      <meta name="robots" content="all" />
      <meta property="og:url" content="{{ page.url | absoluteUrl }}{% if page.url == '/' %}/{% endif %}" />
      <link rel="canonical" href="{{ page.url | absoluteUrl }}{% if page.url == '/' %}/{% endif %}" />
    {% endif %}

    {# Theme before first paint: saved choice, else the OS setting #}
    <script>
      (function () {
        var root = document.documentElement;
        var theme;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.classList.add('js', theme);
        root.style.colorScheme = theme;
      })();
    </script>

    <link rel="preload" href="/assets/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link href="/main.css?v={{ assetVersion }}" rel="stylesheet" />
    {% for stylesheet in stylesheets %}
      <link href="{{ stylesheet }}?v={{ assetVersion }}" rel="stylesheet" />
    {% endfor %}

    <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml" />
    <link rel="manifest" href="/manifest.json?v={{ assetVersion }}" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    {% if env_NODE_ENV != 'development' %}
      <link rel="preconnect" href="https://www.googletagmanager.com" />
      <!-- Google Tag Manager -->
      <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.defer=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','{{ env_GTM_ID }}');</script>
      <!-- End Google Tag Manager -->
    {% endif %}
  </head>
  <body class="flex min-h-screen flex-col">
    {% if env_NODE_ENV != 'development' %}
      <!-- Google Tag Manager (noscript) -->
      <noscript><iframe title="Google Tag Manager" src="https://www.googletagmanager.com/ns.html?id={{ env_GTM_ID }}"
      height="0" width="0" class="invisible hidden"></iframe></noscript>
      <!-- End Google Tag Manager (noscript) -->
    {% endif %}
    {% block schema %}{% endblock schema %}

    <a href="#main" class="sr-only z-50 rounded-md bg-ink px-4 py-2 text-paper focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>

    <header class="relative z-20 border-b border-line bg-paper/90 backdrop-blur print:hidden">
      <div class="mx-auto flex max-w-site flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3 sm:px-6">
        <a href="/" class="group mr-auto flex items-center gap-2.5" aria-label="{{ site.name }}, home">
          <img src="/assets/images/logo-128.png" width="32" height="32" alt="" class="h-8 w-8 transition-transform duration-500 group-hover:-rotate-12 dark:brightness-125" />
          <span class="wordmark-name font-display text-xl font-extrabold tracking-tight">{{ site.name }}</span>
        </a>

        <nav aria-label="Main" class="order-last -mx-1 w-full overflow-x-auto md:order-none md:mx-0 md:w-auto">
          <ul class="flex gap-1 font-mono text-xs font-medium uppercase tracking-[0.12em]">
            {% for item in navItems %}
              {% set isCurrent = page.url.startsWith(item.url) %}
              <li>
                <a href="{{ item.url }}" class="block rounded-md px-2.5 py-2 transition-colors hover:bg-ink/5 {% if isCurrent %}text-ink underline decoration-accent decoration-2 underline-offset-[6px]{% else %}text-muted hover:text-ink{% endif %}" {% if isCurrent %}aria-current="page"{% endif %}>{{ item.label }}</a>
              </li>
            {% endfor %}
          </ul>
        </nav>

        <div class="flex items-center gap-2">
          <a href="/articles/" data-cmdk-open class="flex items-center gap-2 rounded-lg border border-line bg-surface px-3 py-1.5 text-sm text-muted transition-colors hover:border-ink hover:text-ink">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <span>Search</span>
            <span data-cmdk-hint class="hidden gap-1 sm:[.js_&]:inline-flex"><kbd data-cmdk-mod>Ctrl</kbd><kbd>K</kbd></span>
          </a>
          <button type="button" data-theme-toggle class="hidden h-9 w-9 place-items-center rounded-lg [.js_&]:grid border border-line bg-surface text-muted transition-colors hover:border-ink hover:text-ink">
            <svg class="block dark:hidden" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" /></svg>
            <svg class="hidden dark:block" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">{{ content | safe }}</main>

    <footer class="mt-24 border-t border-line print:hidden">
      <div class="mx-auto grid max-w-site gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.6fr_1fr_1fr]">
        <div>
          <a href="/" class="inline-flex items-center gap-2.5">
            <img src="/assets/images/logo-128.png" width="28" height="28" alt="" class="h-7 w-7 dark:brightness-125" loading="lazy" />
            <span class="wordmark-name font-display text-lg font-extrabold tracking-tight">{{ site.name }}</span>
          </a>
          <p class="mt-4 max-w-sm text-muted">Software engineer for the progressive, performant and accessible web. Writing here since 2012.</p>
          <p class="mt-4"><a class="link font-mono text-sm" href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        </div>
        <nav aria-label="Site">
          <p class="eyebrow">Site</p>
          <ul class="mt-4 space-y-2">
            {% for item in navItems %}
              <li><a class="link" href="{{ item.url }}">{{ item.label }}</a></li>
            {% endfor %}
            <li><a class="link" href="/feed.xml">RSS feed</a></li>
          </ul>
        </nav>
        <nav aria-label="Elsewhere">
          <p class="eyebrow">Elsewhere</p>
          <ul class="mt-4 space-y-2">
            {% for item in site.social %}
              <li><a class="link" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      </div>
      <div class="border-t border-line">
        <div class="mx-auto flex max-w-site flex-wrap justify-between gap-x-8 gap-y-2 px-4 py-5 font-mono text-xs text-muted sm:px-6">
          <p>&copy; 2012&ndash;{{ currentYear }} {{ site.name }}. Content and code samples are MIT licensed unless stated otherwise.</p>
          {% set version = 'VERSION' | appVersion %}
          <p>Built with Eleventy{% if version != 'not-set' %} from <span class="tabular">{{ version }}</span>{% endif %}</p>
        </div>
      </div>
    </footer>

    <dialog id="cmdk" class="cmdk mb-auto mt-[12vh] w-[min(36rem,calc(100%-2rem))] overflow-hidden rounded-xl border border-line bg-surface p-0 text-ink shadow-2xl" aria-label="Search and commands" data-email="{{ site.email }}" data-github="{{ site.github }}">
      <input id="cmdk-input" type="text" class="w-full border-b border-line bg-transparent px-4 py-4 text-base outline-none placeholder:text-muted" placeholder="Search articles, projects and pages…" autocomplete="off" spellcheck="false" role="combobox" aria-label="Search articles, projects and pages" aria-expanded="true" aria-controls="cmdk-list" aria-autocomplete="list" />
      <ul id="cmdk-list" class="max-h-[min(24rem,55vh)] overflow-y-auto p-2" role="listbox" aria-label="Results"></ul>
      <div class="flex flex-wrap gap-x-5 gap-y-1 border-t border-line px-4 py-2.5 font-mono text-[11px] text-muted" aria-hidden="true">
        <span><kbd>↑</kbd> <kbd>↓</kbd> move</span>
        <span><kbd>↵</kbd> open</span>
        <span><kbd>esc</kbd> close</span>
      </div>
    </dialog>

    <div id="toast" class="fixed bottom-6 left-1/2 z-50 max-w-[calc(100%-2rem)] -translate-x-1/2 truncate rounded-lg bg-ink px-4 py-2 font-mono text-sm text-paper shadow-lg" role="status" aria-live="polite" hidden></div>

    <script src="/assets/js/site.js?v={{ assetVersion }}" defer></script>
    <script src="/assets/js/command.js?v={{ assetVersion }}" defer></script>
    {% for script in scripts %}
      <script src="{{ script }}?v={{ assetVersion }}" defer></script>
    {% endfor %}
  </body>
</html>
