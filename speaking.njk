---
layout: page.njk
title: Speaking
eyebrow: Talks, workshops and training
description: I have spoken at events, run workshops and led training sessions. Most talks were about my work with Google Map Maker, the rest about web development.
contour: page-speaking
---

<ol class="mt-4">
  {% for talk in talks %}
    <li id="talk-{{ loop.index }}" data-testid="speaking-event" class="grid scroll-mt-24 gap-6 border-b border-line py-10 last:border-0 md:grid-cols-[7rem_1fr_15rem] md:gap-10">
      <p class="font-display text-3xl font-extrabold text-muted tabular">{{ talk.year }}</p>
      <div class="min-w-0">
        <h2 class="font-display text-2xl font-bold leading-snug md:text-3xl">{{ talk.title }}</h2>
        <p class="eyebrow mt-3">{{ talk.event }} &middot; {{ talk.place }}</p>
        <p class="mt-4 max-w-2xl leading-relaxed [&_a]:underline [&_a]:decoration-accent/60 [&_a]:underline-offset-4 hover:[&_a]:text-accent">{{ talk.description | safe }}</p>
        <p class="mt-5 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm">
          {% for link in talk.links %}
            <a class="link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }} <span aria-hidden="true">&nearr;</span></a>
          {% endfor %}
        </p>
      </div>
      <figure class="m-0 md:order-none">
        <img src="{{ talk.image }}" alt="{{ talk.alt }}" width="450" height="450" loading="lazy" decoding="async" class="aspect-square w-full max-w-xs rounded-xl border border-line object-cover md:max-w-none" />
        <figcaption class="mt-2 font-mono text-xs text-muted">&copy; {{ talk.credit }}</figcaption>
      </figure>
    </li>
  {% endfor %}
</ol>
