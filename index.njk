---
layout: base.njk
scripts:
  - /assets/js/contour-core.js
  - /assets/js/contour.js
---

{# Hero: a live contour map. The SVG underneath is the first paint and the no-JS version. #}
<section data-contour-live="home" class="group relative isolate touch-pan-y overflow-hidden border-b border-line" aria-labelledby="hero-name">
  <div data-contour-static class="contour-mask absolute inset-0 -z-10 transition-opacity duration-700 group-[.is-live]:opacity-0" style="--contour-src: url('/contour/home.svg')" aria-hidden="true"></div>
  <canvas class="absolute inset-0 -z-10 h-full w-full opacity-0 transition-opacity duration-700 group-[.is-live]:opacity-100" aria-hidden="true"></canvas>

  <ul class="pointer-events-none absolute inset-0 hidden font-mono text-[11px] font-medium uppercase tracking-[0.1em] lg:block" aria-hidden="true">
    {% for item in work %}
      {% set spot = [['70%', '24%'], ['85%', '42%'], ['64%', '58%'], ['80%', '70%']][loop.index0] %}
      <li class="waypoint absolute flex items-center gap-2" style="left: {{ spot[0] }}; top: {{ spot[1] }}">
        <span class="rounded bg-paper/90 px-1.5 py-0.5">{{ item.name }}</span>
      </li>
    {% endfor %}
  </ul>

  <div class="mx-auto flex min-h-[min(44rem,calc(100svh-4.5rem))] max-w-site flex-col px-4 pb-8 pt-16 sm:px-6">
    <div class="relative mt-auto max-w-2xl">
      <div class="contour-halo absolute -inset-x-20 -inset-y-12 -z-10" aria-hidden="true"></div>
      <p class="eyebrow">{{ site.role | replace(' / ', ' · ') }} at <a class="link text-ink" href="{{ site.employer.url }}">{{ site.employer.name }}</a></p>
      <h1 id="hero-name" class="wordmark-name mt-5 font-display text-[clamp(4.25rem,19vw,9rem)] font-extrabold leading-[0.84] tracking-[-0.03em]">Jabran<br />Rafique</h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed md:text-xl">
        I build the progressive, performant and accessible web, now for millions of people at Sky. From 2008 to 2013 I also helped
        <a class="link" href="/speaking/">map the unmapped</a> on Google Map Maker.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/articles/" class="inline-flex items-center gap-2 rounded-lg bg-ink px-5 py-3 text-sm font-medium text-paper transition-opacity hover:opacity-85">Read the articles <span aria-hidden="true">&rarr;</span></a>
        <a href="/projects/" class="inline-flex items-center rounded-lg border border-ink/25 bg-paper/70 px-5 py-3 text-sm font-medium backdrop-blur transition-colors hover:border-ink">Projects</a>
        <a href="/resume/" class="inline-flex items-center rounded-lg border border-ink/25 bg-paper/70 px-5 py-3 text-sm font-medium backdrop-blur transition-colors hover:border-ink">Resume</a>
      </div>
    </div>

    <div class="mt-14 flex flex-wrap items-end justify-between gap-6 font-mono text-xs text-muted" aria-hidden="true">
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <span class="waypoint flex items-center gap-1.5">Project</span>
        <span class="flex items-center gap-1.5"><i class="block w-5 border-t border-ink/50"></i>10 m contour</span>
        <span class="hidden items-center gap-1.5 [.js_&]:flex"><i class="block w-5 border-t-2 border-accent"></i>You are here</span>
      </div>
      <div class="text-left text-ink sm:text-right">
        <p class="tabular" data-contour-pos>51.5072° N&ensp;0.1276° W</p>
        <p class="mt-0.5 hidden text-muted [.js_&]:block" data-contour-elev>Move across the map to survey it</p>
        <p class="mt-2 flex items-center gap-2 sm:justify-end"><i class="scale-bar"></i>500 m</p>
      </div>
    </div>
  </div>
</section>

{# Selected work #}
<section class="mx-auto max-w-site px-4 pt-20 sm:px-6 md:pt-28" aria-labelledby="work-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Side projects</p>
      <h2 id="work-heading" class="mt-3 font-display text-4xl font-extrabold tracking-[-0.02em] md:text-5xl">Selected work</h2>
    </div>
    <a href="/projects/" class="link font-mono text-sm">All projects &rarr;</a>
  </div>
  <p class="mt-4 max-w-xl text-muted">Things I build in my own time. Most of my projects are open source on <a class="link text-ink" href="{{ site.github }}">GitHub</a>.</p>

  <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {% for item in work %}
      <li>
        <a href="{{ item.url }}" class="group flex h-full flex-col overflow-hidden rounded-xl border border-line bg-surface transition-colors hover:border-ink">
          <div class="relative aspect-[16/7] overflow-hidden border-b border-line sm:aspect-[16/10]" aria-hidden="true">
            <div class="contour-mask absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-110" style="--contour-src: url('/contour/{{ item.map }}.svg')"></div>
            <span class="waypoint absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 scale-150 transition-transform duration-300 group-hover:-translate-y-[70%]"></span>
          </div>
          <div class="flex flex-1 flex-col p-5">
            <p class="eyebrow">{{ item.kind }}</p>
            <h3 class="mt-2 font-display text-xl font-bold">{{ item.name }}</h3>
            <p class="mt-2 text-sm text-muted">{{ item.description }}</p>
            <p class="mt-auto pt-5 font-mono text-xs font-medium group-hover:text-accent">{{ item.cta }} <span aria-hidden="true">&nearr;</span></p>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

{# Latest writing #}
<section class="mx-auto max-w-site px-4 pt-20 sm:px-6 md:pt-28" aria-labelledby="writing-heading">
  <div class="grid gap-10 md:grid-cols-[1fr_2fr]">
    <div>
      <p class="eyebrow">Since 2012</p>
      <h2 id="writing-heading" class="mt-3 font-display text-4xl font-extrabold tracking-[-0.02em] md:text-5xl">Latest writing</h2>
      <p class="mt-4 max-w-sm text-muted">Notes on web engineering, tooling and maps. {{ collections.articles.length }} articles so far.</p>
      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm">
        <a href="/articles/" class="link">All articles &rarr;</a>
        <a href="/articles/" data-cmdk-open class="link">Search them</a>
      </p>
    </div>
    <ol class="border-t border-line">
      {% for article in collections.articles | reverse %}
        {% if loop.index <= 5 %}
          <li class="border-b border-line">
            <a href="{{ article.url }}" class="group grid grid-cols-[3.5rem_1fr] items-baseline gap-4 py-5">
              <span class="font-mono text-sm text-muted tabular">{{ article.date | format_date('YYYY') }}</span>
              <span>
                <span class="block font-display text-xl font-bold leading-snug transition-colors group-hover:text-accent md:text-2xl" style="view-transition-name: {{ article.url | vtName }}">{{ article.data.title }}</span>
                {% if article.data.excerpt %}<span class="mt-1 line-clamp-2 block text-muted">{{ article.data.excerpt | striptags }}</span>{% endif %}
              </span>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </div>
</section>

{# Talks #}
<section class="pt-20 md:pt-28" aria-labelledby="talks-heading">
  <div class="mx-auto flex max-w-site flex-wrap items-end justify-between gap-4 px-4 sm:px-6">
    <div>
      <p class="eyebrow">2010&ndash;2019</p>
      <h2 id="talks-heading" class="mt-3 font-display text-4xl font-extrabold tracking-[-0.02em] md:text-5xl">On stage</h2>
      <p class="mt-4 max-w-xl text-muted">Talks on maps and open data, from TEDx Lahore to Google Big Tent in Sendai.</p>
    </div>
    <a href="/speaking/" class="link font-mono text-sm">All talks &rarr;</a>
  </div>
  <ul class="mx-auto mt-10 flex max-w-site scroll-px-4 snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:scroll-px-6 sm:px-6 [scrollbar-width:thin]">
    {% for talk in talks %}
      <li class="w-64 shrink-0 snap-start md:w-72">
        <a href="/speaking/#talk-{{ loop.index }}" class="group block">
          <div class="overflow-hidden rounded-xl border border-line">
            <img src="{{ talk.image }}" alt="{{ talk.alt }}" width="450" height="450" loading="lazy" decoding="async" class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
          <p class="mt-3 font-mono text-xs text-muted"><span class="tabular">{{ talk.year }}</span> &middot; {{ talk.event }}, {{ talk.place }}</p>
          <p class="mt-1 font-display text-lg font-bold leading-snug group-hover:text-accent">{{ talk.title }}</p>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
